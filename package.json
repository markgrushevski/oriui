{
    "name": "oriui",
    "description": "oriUI monorepo (織り) — @oriui/vue styled components, @oriui/headless behavior, @oriui/css standalone styles, and the docs site",
    "license": "MIT",
    "version": "1.0.0-alpha.1",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "author": {
        "name": "Leonid",
        "email": "markgrushevski@gmail.com",
        "url": "https://github.com/markgrushevski"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markgrushevski/oriui.git"
    },
    "bugs": {
        "url": "https://github.com/markgrushevski/oriui/issues"
    },
    "homepage": "https://oriui.vercel.app",
    "workspaces": [
        "docs",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace docs",
        "types": "npm run types --workspaces --if-present",
        "build": "npm run build:packages",
        "build:packages": "npm run build -w @oriui/css && npm run build -w @oriui/headless && npm run build -w @oriui/vue",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:types": "vue-tsc -p tsconfig.vitest.json --noEmit",
        "test:e2e": "npm run build -w @oriui/css && playwright test",
        "size": "size-limit",
        "size:build": "npm run build && size-limit",
        "lint:prettier": "npx prettier --write \"**/*.{vue,js,mjs,ts,json,md,html,css}\"",
        "lint:stylelint": "npx stylelint --fix \"packages/vue/src/**/*.{vue,css}\" \"packages/css/src/**/*.css\"",
        "lint:eslint": "npx eslint --fix \"packages/*/src/**/*.{vue,ts}\" \"*.mjs\" \"scripts/**/*.mjs\" \"packages/*/*.mjs\" \"packages/*/scripts/**/*.mjs\"",
        "lint:all": "npm run lint:prettier && npm run lint:stylelint && npm run lint:eslint",
        "lint:ci": "prettier --check \"**/*.{vue,js,mjs,ts,json,md,html,css}\" && stylelint \"packages/vue/src/**/*.{vue,css}\" \"packages/css/src/**/*.css\" && eslint \"packages/*/src/**/*.{vue,ts}\" \"*.mjs\" \"scripts/**/*.mjs\" \"packages/*/*.mjs\" \"packages/*/scripts/**/*.mjs\"",
        "check:publint": "publint ./packages/css && publint ./packages/headless && publint ./packages/vue",
        "check:attw": "attw --pack ./packages/headless --profile node16 --ignore-rules cjs-resolves-to-esm && attw --pack ./packages/vue --profile node16 --ignore-rules cjs-resolves-to-esm",
        "smoke": "node scripts/smoke-pack.mjs",
        "smoke:build": "npm run build && npm run smoke",
        "gate": "npm run lint:ci && npm run types && npm run test:types && npm run test && npm run build && npm run size && npm run check:publint && npm run check:attw && npm run smoke && npm run docs:build",
        "prepare": "husky",
        "changeset": "changeset",
        "version": "changeset version && npm install --package-lock-only",
        "release": "npm run build && node scripts/publish.mjs",
        "docs:dev": "npm run dev --workspace docs",
        "docs:build": "npm run generate --workspace docs",
        "docs:preview": "npm run preview --workspace docs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@size-limit/esbuild": "^12.1.0",
        "@size-limit/file": "^12.1.0",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.1",
        "axe-core": "^4.13.0",
        "colord": "^2.10.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "postcss": "^8.5.28",
        "postcss-html": "^1.8.1",
        "prettier": "^3.9.9",
        "publint": "0.3.25",
        "react-dom": "^19.3.0",
        "size-limit": "^12.1.0",
        "stylelint": "^17.16.0",
        "stylelint-config-property-sort-order-smacss": "^11.2.0",
        "stylelint-config-standard-vue": "^1.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^4.1.11",
        "vue": "^3.5.43",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.12"
    },
    "overrides": {
        "mdast-util-to-markdown": "2.1.2"
    }
}
