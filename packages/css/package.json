{
    "name": "@oriui/css",
    "version": "1.0.0-rc.24",
    "description": "Design tokens and .ori-* component classes for oriUI. No JavaScript, no build step.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markgrushevski/oriui.git",
        "directory": "packages/css"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "CHANGELOG.md",
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "style": "./dist/styles.css",
    "exports": {
        ".": "./dist/styles.css",
        "./styles.css": "./dist/styles.css",
        "./base.css": "./dist/base.css",
        "./tokens.css": "./dist/tokens.css",
        "./reset.css": "./dist/reset.css",
        "./components/*.css": "./dist/components/*.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node build.mjs",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "autoprefixer": "^10.6.1",
        "cssnano": "^8.0.10",
        "postcss": "^8.5.28",
        "postcss-import": "^17.0.0"
    }
}
