{
    "name": "@oriui/headless",
    "version": "1.0.0-rc.24",
    "description": "Headless behavior for oriUI: focus, keyboard and ARIA, as a framework-free engine with a Vue adapter.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markgrushevski/oriui.git",
        "directory": "packages/headless"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "files": [
        "CHANGELOG.md",
        "dist",
        "src/core",
        "src/vue"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js",
            "default": "./dist/core/index.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue/index.js",
            "default": "./dist/vue/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "prepack": "npm run build",
        "types": "tsc --noEmit"
    },
    "peerDependencies": {
        "vue": "^3.5"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "react": "^19.3.0",
        "svelte": "^5.57.1",
        "tsdown": "^0.23.0"
    }
}
